{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MacKVM Backlog Manifest Issue",
  "type": "object",
  "required": [
    "id",
    "title",
    "milestone",
    "epic",
    "tier",
    "risk",
    "depends_on",
    "exact_files",
    "commands",
    "issue_file"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^M[1-5]-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "milestone": {
      "enum": [
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ]
    },
    "epic": {
      "enum": [
        "E00",
        "E01",
        "E02",
        "E03",
        "E04",
        "E05",
        "E06",
        "E07",
        "E08",
        "E09",
        "E10",
        "E11",
        "E12",
        "E13",
        "E14",
        "E15",
        "E16"
      ]
    },
    "tier": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exact_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "issue_file": {
      "type": "string"
    }
  }
}