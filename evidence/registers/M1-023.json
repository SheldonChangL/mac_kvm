  "policy": {
    "consumableDisposition": "approved",
    "unknownFieldPolicy": "remain-unknown-and-block-wire-claim",
    "mutationPolicy": "append-only-supersede-never-rewrite",
    "rawCapturePolicy": "outside-repository-until-sanitized-and-reviewed",
    "syntheticEvidencePolicy": "cannot-establish-wire-claim-without-approved-source",
    "prohibitedContent": [
      "Barrier-or-Deskflow-source",
      "Barrier-or-Deskflow-header",
      "GPL-derived-constant-table",
      "decompiled-implementation",
      "typed-text",
      "clipboard-payload",
      "credential",
      "private-key",
      "token",
      "hostname",
      "ip-address",
      "other-private-data"
    ]
  },
  "entryContract": {
    "evidenceIdPattern": "^BARRIER-EVID-[0-9]{4}$",
    "relatedIssuePattern": "^M[1-5]-[0-9]{3}$",
    "utcDateTimePattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
    "fixturePathPattern": "^Tests/Fixtures/Barrier/(?!.*(?:\\.\\./|/\\.\\.(?:/|$)))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
    "sha256Pattern": "^[a-f0-9]{64}$",
    "sourceCategories": [
      "public-specification",
      "black-box-capture",
      "sanitized-conformance-vector"
    ],
    "dispositions": [
      "pending-review",
      "approved",
      "rejected",
      "quarantined",
      "superseded"
    ],
    "consumableDisposition": "approved",
    "emptyEntriesStatus": "initialized-no-approved-evidence",
    "nonemptyEntriesStatus": "active",
    "approvedEntryRequiresWireClaim": true,
    "fixtureIntegrity": "regular-non-symlink-streamed-sha256-and-length",
    "directions": [
      "server-to-client",
      "client-to-server",
      "bidirectional"
    ],
    "allowedObjectKeys": {
      "$": [
        "evidenceId",
        "relatedIssue",
        "source",
        "capture",
        "peer",
        "transport",
        "provenance",
        "sanitization",
        "fixture",
        "coverage",
        "limitations",
        "ambiguousFields",
        "prohibitedInferences",
        "frozenContractRefs",
        "consumingTests"
      ],
      "source": ["category", "acquisitionMethod"],
      "capture": ["capturedAt", "tools"],
