      "peer": ["product", "version", "role", "os"],
      "peer.os": ["name", "version", "build"],
      "transport": ["networkScope", "tls"],
      "transport.tls": [
        "enabled",
        "protocolVersion",
        "certificateIdentitySanitized"
      ],
      "provenance": [
        "lawfulUseStatement",
        "permittedUse",
        "producer",
        "reviewer",
        "disposition"
      ],
      "provenance.reviewer": [
        "identity",
        "independentFromProducer",
        "reviewedAt"
      ],
      "sanitization": [
        "procedure",
        "status",
        "containsSensitiveData",
        "removedCategories"
      ],
      "fixture": ["path", "sha256", "byteLength"],
      "coverage": ["direction", "behaviors", "wireClaims"],
      "coverage.wireClaims[]": [
        "claimId",
        "assertion",
        "establishedFieldIds",
        "evidenceLocations"
      ],
      "ambiguousFields[]": [
        "fieldId",
        "observation",
        "status",
