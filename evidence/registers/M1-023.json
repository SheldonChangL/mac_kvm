      "provenance.disposition",
      "sanitization.procedure",
      "sanitization.status",
      "sanitization.containsSensitiveData",
      "sanitization.removedCategories",
      "fixture.path",
      "fixture.sha256",
      "fixture.byteLength",
      "coverage.direction",
      "coverage.behaviors",
      "coverage.wireClaims",
      "limitations",
